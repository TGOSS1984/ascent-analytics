	column 'Is First Booking' = VAR CustomerId = FactBookings[customer_id] VAR CurrentTourDate = FactBookings[tour_date_id] VAR FirstTourDate = CALCULATE(MIN(FactBookings[tour_date_id]), ALLEXCEPT(FactBookings, FactBookings[customer_id])) RETURN IF(CurrentTourDate = FirstTourDate, "New", "Returning")
		lineageTag: 7245d0e7-f24a-4438-8ff2-e93bcb38a878
