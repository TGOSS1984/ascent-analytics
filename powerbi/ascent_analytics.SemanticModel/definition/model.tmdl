model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimCustomer","DimMarketingChannel","DimRegion","FactEquipmentHire","FactMarketing","FactPayments","FactReviews","FactWeather","FactWebsiteAnalytics","Summary_CustomerLTV","Summary_GuidePerformance","Summary_RoutePerformance","Summary_WeatherFlaggedCancellations","core_pipeline_log","extension_pipeline_log","PipeLineQualityLog","DimDate","DimGuide","DimRoute","FactBookings","WaterfallSteps","browser_icons"]

annotation PBI_ProTooling = ["DevMode"]

ref table DimCustomer
ref table DimMarketingChannel
ref table DimRegion
ref table FactEquipmentHire
ref table FactMarketing
ref table FactPayments
ref table FactReviews
ref table FactWeather
ref table FactWebsiteAnalytics
ref table Summary_CustomerLTV
ref table Summary_GuidePerformance
ref table Summary_RoutePerformance
ref table Summary_WeatherFlaggedCancellations
ref table PipeLineQualityLog
ref table DimDate
ref table DimGuide
ref table DimRoute
ref table FactBookings
ref table WaterfallSteps
ref table browser_icons

ref cultureInfo en-GB

