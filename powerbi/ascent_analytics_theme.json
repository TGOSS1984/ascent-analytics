{
  "name": "Ascent Analytics",
  "dataColors": [
    "#B0CFD0",
    "#D6C18E",
    "#8FE3FF",
    "#C7B06A",
    "#7F9499",
    "#A8B48A",
    "#91A8B2",
    "#BDC0AE",
    "#405664",
    "#6A8A72"
  ],
  "background": "#0C1D29",
  "foreground": "#EEF3F6",
  "tableAccent": "#B0CFD0",
  "good": "#7FBF8C",
  "neutral": "#D6C18E",
  "bad": "#C1666B",
  "maximum": "#8FE3FF",
  "center": "#91A8B2",
  "minimum": "#FFD27A",
  "null": "#5B6E77",
  "textClasses": {
    "callout": {
      "fontFace": "Inter",
      "color": "#EEF3F6",
      "fontSize": 32
    },
    "title": {
      "fontFace": "Inter",
      "color": "#EEF3F6",
      "fontSize": 14
    },
    "header": {
      "fontFace": "Inter",
      "color": "#C8D6DC",
      "fontSize": 12
    },
    "label": {
      "fontFace": "Inter",
      "color": "#B0CFD0",
      "fontSize": 10
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0D1C27"
              }
            },
            "transparency": 15
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#B0CFD0"
              }
            },
            "radius": 12
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#07131C"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#EEF3F6"
              }
            },
            "fontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#22394A"
              }
            },
            "axisColor": {
              "solid": {
                "color": "#5B6E77"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#EEF3F6"
              }
            },
            "fontSize": 10,
            "gridlineColor": {
              "solid": {
                "color": "#22394A"
              }
            },
            "axisColor": {
              "solid": {
                "color": "#5B6E77"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#EEF3F6"
              }
            },
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#EEF3F6"
              }
            },
            "fontSize": 10
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#EEF3F6"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#07131C"
              }
            },
            "transparency": 0
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#07131C"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#EEF3F6"
              }
            },
            "fontSize": 28,
            "fontFamily": "Inter"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#B0CFD0"
              }
            },
            "fontSize": 11,
            "fontFamily": "Inter"
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "card": [
          {
            "outlineColor": {
              "solid": {
                "color": "#B0CFD0"
              }
            },
            "outlineWeight": 1
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#122431"
              }
            },
            "transparency": 40
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#EEF3F6"
              }
            },
            "activeFontColor": {
              "solid": {
                "color": "#8FE3FF"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "rowPadding": 6
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0C1B24"
              }
            },
            "backColor": {
              "solid": {
                "color": "#B0CFD0"
              }
            },
            "fontFamily": "Inter",
            "bold": true
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#EEF3F6"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0D1C27"
              }
            },
            "fontFamily": "Inter"
          }
        ]
      }
    }
  },
  "filterPane": {
    "transparency": 0,
    "background": {
      "solid": {
        "color": "#0D1C27"
      }
    },
    "foreground": {
      "solid": {
        "color": "#EEF3F6"
      }
    },
    "inputBoxColor": {
      "solid": {
        "color": "#12243B"
      }
    }
  }
}